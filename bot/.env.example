# Copy to .env for local development (`npm run dev`). In Docker Compose these
# come from the root .env instead — see ../.env.example.

# Bot API token from @BotFather. Required; the bot refuses to start without it.
TELEGRAM_BOT_TOKEN=

# Base URL of the SOPDS catalog API this bot is a client of.
SOPDS_API_URL=http://localhost:8000

# Optional access control: comma/whitespace separated Telegram numeric user
# ids (not @usernames - get yours from @userinfobot or @getidsbot). Left
# blank, anyone who finds the bot can use it. Set, only these ids can.
TELEGRAM_ALLOWED_USERS=
