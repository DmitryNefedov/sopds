# Copy to .env for local development (`npm run dev`). In Docker Compose these
# come from the root .env instead — see ../.env.example.

# Bot API token from @BotFather. Required; the bot refuses to start without it.
TELEGRAM_BOT_TOKEN=

# Base URL of the SOPDS catalog API this bot is a client of.
SOPDS_API_URL=http://localhost:8000

# Optional access control - comma/whitespace separated Telegram numeric ids.
# Both blank: anyone who finds the bot can use it (the default). Set either
# one and it's restricted: a listed user can use the bot from anywhere
# (private chat or group); a listed group lets any of its members in, even
# ones not individually listed.
#
# User ids (not @usernames - those can change): get yours from @userinfobot
# or @getidsbot.
TELEGRAM_ALLOWED_USERS=
# Group/supergroup chat ids (negative numbers): add the bot to the group,
# send a message, then check @getidsbot or the bot's own logs for the chat id.
TELEGRAM_ALLOWED_CHATS=
