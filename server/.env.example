# Copy to .env (or export in your shell) and adjust.

# HTTP port for the API / combined server
PORT=8000

# Absolute path to your book collection directory
SOPDS_ROOT_LIB=/path/to/books

# SQLite database file (created automatically)
SOPDS_DB=./data/sopds.db

# Space separated list of recognised book extensions
SOPDS_BOOK_EXTENSIONS=.fb2 .epub .mobi .pdf .djvu

# Scan .zip archives for books (1 = yes, 0 = no)
SOPDS_ZIPSCAN=1

# Items per page in listings
SOPDS_MAXITEMS=50

# Hide duplicate books in listings (1 = yes, 0 = no)
SOPDS_DOUBLES_HIDE=1

SOPDS_TITLE=SimpleOPDS Catalog
SOPDS_SUBTITLE=Powered by Node + React
