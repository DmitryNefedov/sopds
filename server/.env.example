# Copy to .env (or export in your shell) and adjust.
#
# These are BOOTSTRAP DEFAULTS only. Once the server has run, edit the
# settings on the /settings page instead - they are stored in the database
# and take effect without a restart.

# HTTP port for the API / combined server
PORT=8000

# Interface to bind. Default 0.0.0.0 = reachable from other devices on the
# LAN (e-readers, tablets). Set to 127.0.0.1 to restrict to this machine.
HOST=0.0.0.0

# PostgreSQL connection. Either set DATABASE_URL, or the discrete PG* vars.
# DATABASE_URL=postgres://sopds:sopds@localhost:5432/sopds
PGHOST=localhost
PGPORT=5432
PGUSER=sopds
PGPASSWORD=sopds
PGDATABASE=sopds

# Optional shared secret for the /settings admin API.
# When set, requests must send it as the X-Admin-Token header.
SOPDS_ADMIN_TOKEN=

# --- initial defaults for settings shown on the /settings page ----------

# Absolute path to your book collection directory
SOPDS_ROOT_LIB=/path/to/books

# Space separated list of recognised book extensions
SOPDS_BOOK_EXTENSIONS=.fb2 .epub .mobi .pdf .djvu

# Scan .zip archives for books (1 = yes, 0 = no). Archives are read entry by
# entry — never expanded to disk and never loaded whole into memory.
SOPDS_ZIPSCAN=1

# During a scan, commit and publish books to the catalog in batches of this
# many, instead of one transaction at the end. Books become searchable and
# downloadable while a large first scan is still running.
SOPDS_SCAN_BATCH_SIZE=1000

# Items per page in listings
SOPDS_MAXITEMS=50

# Hide duplicate books in listings (1 = yes, 0 = no)
SOPDS_DOUBLES_HIDE=1

SOPDS_TITLE=SimpleOPDS Catalog
SOPDS_SUBTITLE=Powered by Node + React

# Format conversion. The server converts fb2/epub/mobi between each other
# on demand. It uses the built-in converters by default; if Calibre's
# `ebook-convert` is installed it is used instead (better fidelity).
# Set to a full path, a bare command name to look up on PATH, or "" to
# force the built-in converters.
SOPDS_EBOOK_CONVERT=ebook-convert
# Directory for cached converted files
SOPDS_CONVERT_CACHE=./data/convert-cache
