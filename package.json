{
  "name": "sopds",
  "version": "1.0.0",
  "private": true,
  "description": "SimpleOPDS - OPDS & web catalog server (Node.js + React)",
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "scan": "npm --workspace server run scan",
    "samples": "npm --workspace server run samples",
    "server": "npm --workspace server start",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "start": "npm run build && npm --workspace server start",
    "test": "npm --workspace server test"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
