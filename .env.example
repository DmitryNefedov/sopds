# Copy to .env — used by `docker compose`.

# ---- e-book collection ------------------------------------------------
# Host folder that holds your books (FB2 / EPUB / MOBI / PDF / DjVu / .zip).
# Mounted read-only into the api container at /books.
SOPDS_BOOKS_DIR=./books

# ---- postgres storage ----------------------------------------------
# Where postgres keeps its data. Leave as-is to use the Docker named volume
# "sopds-pgdata", or set an absolute host path to bind-mount a directory,
# e.g. SOPDS_PGDATA=/srv/sopds/pg
SOPDS_PGDATA=sopds-pgdata

# ---- database credentials ----------------------------------------
POSTGRES_USER=sopds
POSTGRES_PASSWORD=sopds
POSTGRES_DB=sopds

# ---- exposed ports -------------------------------------------------
# Web UI (nginx)
SOPDS_UI_PORT=8080
# Raw API + OPDS feed (for OPDS reader apps): http://host:8000/opds/
SOPDS_OPDS_PORT=8000

# ---- catalog ------------------------------------------------------
SOPDS_TITLE=SimpleOPDS Catalog
SOPDS_SUBTITLE=Powered by Node + React
# Optional shared secret protecting the /settings admin API.
SOPDS_ADMIN_TOKEN=
